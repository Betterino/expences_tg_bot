# Copy to .env and fill in. Never commit .env.
# Bot token from @BotFather (required).
API_KEY=
# Your Telegram user id: shows the 🧪 Тест sandbox in Settings. Empty = hidden for everyone.
ADMIN_ID=
# 1 = log message texts (personal data). Leave 0 in production.
LOG_MESSAGE_TEXT=0
# Optional: where expenses.db, backups/ and logs/ live. Default: ./data (in Docker: /app/data).
# DATA_DIR=
